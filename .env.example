# Supabase PostgreSQL Configuration
# Used for Vixora Academy student portal, persistent enrollments, certificates, and email logs.
# Find these in your Supabase project dashboard under Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Admin Authentication Allowlist
# Comma-separated list of authorized administrator emails for Supabase Auth admin access.
ADMIN_EMAILS="admin@vixoradigitalhub.com,vixoralabsai@gmail.com"

# Resend & SMTP Email Configuration
# Configure these in Settings -> Secrets to deliver live emails to real inboxes
RESEND_API_KEY=
RESEND_FROM="Vixora Academy <onboarding@resend.dev>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vixora Academy <academy@vixoradigitalhub.com>"

# Paystack Payment Gateway Configuration
# Obtain your API keys from Paystack Dashboard -> Settings -> API Keys & Webhooks
# Use test keys (sk_test_... / pk_test_...) during testing, and live keys (sk_live_... / pk_live_...) for production.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
